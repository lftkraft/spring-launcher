{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spring Launcher",
  "version": "1.0.2",
  "identifier": "com.spring.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Spring Launcher",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' tauri: asset: data: https://*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' tauri: asset: https://*;"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "krisz, resokrisz",
    "copyright": "Copyright © 2026 krisz, resokrisz",
    "shortDescription": "Spring Launcher",
    "longDescription": "Spring Launcher for Minecraft",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwREZFNzE4NjA5QzAwQTUKUldTbEFKeGdHT2ZmZ0w4ZFp3Um9iM2pxSHYwNmp4OWRYUjRYd3h6ZmNaRXVaVU9qSEdWVHhCQXcK",
      "endpoints": [
        "https://github.com/lftkraft/spring-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
